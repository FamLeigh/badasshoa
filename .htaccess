# BadassHOA — root Apache config
# Works on MAMP local and Hostinger shared hosting (Apache 2.4 / LiteSpeed-compatible).

DirectoryIndex index.php index.html
Options -Indexes -MultiViews

# Friendly 404 — funny "Violation Notice" page
ErrorDocument 404 /404.php

# --- Per-association public landing: /{slug}/ → landing.php?slug={slug} ----
# Real files / directories take precedence (so /dashboard/, /admin/, /assets/,
# /storage/, /login.php, /signup.php, /pricing.php, /changelog.php, etc. all
# keep working). Only single-segment lowercase slugs hit the rewrite.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # /tv and /tv/ → tv.php (must come before the slug catch-all)
    RewriteRule ^tv/?$ /tv.php [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI}      !^/(landing|branding|public-media|public-document|contact|user-avatar|newsletter-signup|newsletter-unsubscribe|tv)\.php
    RewriteRule ^([a-z0-9][a-z0-9-]*)/?$  /landing.php?slug=$1  [QSA,L]
</IfModule>

# --- Block dotfiles, configs, and migration SQL from web access -----------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(config\.php|composer\.(json|lock)|package(-lock)?\.json|README\.md|CLAUDE\.md|DEPLOY\.md|badassHOA_claude_code_instructions\.md)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|log|sh|env)$">
    Require all denied
</FilesMatch>

# Note: /storage/ and its subtree are blocked by storage/.htaccess (Require all denied).
# We can't `<Directory>` here — that's a server-config-only directive. The .htaccess
# inside storage/ is the right place for that scope.

# --- Security headers ----------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options       "nosniff"
    Header always set X-Frame-Options              "SAMEORIGIN"
    Header always set Referrer-Policy              "strict-origin-when-cross-origin"
    Header always set Permissions-Policy           "camera=(), microphone=(), geolocation=()"
    # HSTS: enable only after you've confirmed HTTPS works end-to-end on production.
    # Header always set Strict-Transport-Security  "max-age=15552000; includeSubDomains"
</IfModule>

# --- Cache static assets aggressively (bust via filename if needed) -------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 30 days"
    ExpiresByType application/javascript  "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/webp              "access plus 30 days"
    ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

# --- Force HTTPS on production -------------------------------------------
# Hostinger usually does this at the platform level; uncomment if your plan doesn't.
